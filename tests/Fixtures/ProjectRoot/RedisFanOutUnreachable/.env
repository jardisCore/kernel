# Redis is configured but unreachable — proves the fan-out (D4) is lazy
# (Bescheid Rolf 2026-10-15): the kernel builds, the "redis" cache layer throws
# InvalidEnvConfigurationException at its first access, and the "redis" log
# handler reports the failure at its first write instead of failing the boot.
REDIS_HOST=nonexistent_host_that_does_not_exist
REDIS_PORT=6379

CACHE_LAYERS=redis
LOG_HANDLERS=redis
