# =============================================================================
# Jardis project configuration — ONE file, in the project ROOT
# =============================================================================
# Copy this file to `<projectRoot>/.env` (strip the ".example" suffix) and
# edit it. `BuildDomainKernelFromEnv` reads it via DotEnv::loadPrivate(), so
# the usual cascade applies: `.env` -> `.env.local` -> `.env.{APP_ENV}`, plus
# any `load()`/`load?()` include you add yourself.
#
# There is no `config/` layer any more: every configuration value of a Jardis
# project lives exactly once, here. A value you want to look up is in this one
# file — or in the process environment, which ALWAYS wins over this file
# (jardissupport/dotenv >= 1.4.0, 12-factor III). That is what makes a
# container without any `.env` work: pass the same keys as `environment:`
# entries and hand the packer an empty string instead of a file.
#
# BLOCK CONTRACT — the tooling (Jardis Builder, App-Template parity check)
# reads this file blockwise. Every `KEY=value` line MUST sit under exactly one
# `# === <block> ===` header, and `<block>` MUST be one of:
#   app | database | redis | cache | logger | http | mail | messaging
# Keeping a key in the right block is not cosmetic — it is how a service gets
# switched on and off as a unit.
# =============================================================================


# === app ===
# -----------------------------------------------------------------------------
# APP_ENV selects the cascade overlay (`.env.{APP_ENV}`). Set it in the
# process environment (your image usually already does) rather than here, so
# one image can serve dev/test/prod without a file change.
#APP_ENV=prod
#
# APP_SECRET_KEY is the master key for `secret(...)` values. It belongs in the
# PROCESS ENVIRONMENT ONLY — never in this file. A key written here would have
# to be read by the very load it is supposed to unlock, and it would sit in
# the kernel's `$env` array in plaintext. Without it, the kernel falls back to
# `<projectRoot>/support/secret.key`; with neither, an encrypted value aborts
# the boot instead of being passed on as a cipher.
# APP_SECRET_KEY=<base64 32-byte key> — process environment only, never in this file


# === database ===
# -----------------------------------------------------------------------------
# BuildConnectionFromEnv. Driver: mysql (default) | pgsql | sqlite.
# DB_HOST unset or empty -> no connection at all, no error.
# -----------------------------------------------------------------------------
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_DATABASE=app
DB_CHARSET=utf8mb4

# --- SQLite (overrides everything above) --------------------------------------
#DB_DRIVER=sqlite
#DB_PATH=:memory:

# --- PostgreSQL ---------------------------------------------------------------
#DB_DRIVER=pgsql
#DB_PORT=5432

# --- Read replicas (optional; the pool needs jardisadapter/dbconnection —
# without the adapter a single plain PDO on DB_HOST is used) -------------------
#DB_READER1_HOST=replica1.internal
#DB_READER1_PORT=3306
#DB_READER1_USER=root
#DB_READER1_PASSWORD=
#DB_READER1_DATABASE=app
#DB_READER2_HOST=replica2.internal

# --- Pool tuning (optional, only read when a ConnectionPool is built — i.e.
# at least one DB_READER{N}_HOST plus jardisadapter/dbconnection installed).
# Setting NONE keeps the adapter's ConnectionPoolConfig defaults; setting ANY
# builds an explicit config where only the set keys deviate.
# DB_POOL_STICKY_WRITER requires jardisadapter/dbconnection >= 1.1.0 — on
# older versions the pool build fails and the fallback to a plain PDO on
# DB_HOST applies (with an error_log notice). ------------------------------
#DB_POOL_VALIDATE_CONNECTIONS=true
#DB_POOL_HEALTH_CHECK_CACHE_TTL=30
#DB_POOL_HEALTH_CHECK_NEGATIVE_CACHE_TTL=0
#DB_POOL_LOAD_BALANCING_STRATEGY=round-robin
#DB_POOL_STICKY_WRITER=false


# === redis ===
# -----------------------------------------------------------------------------
# BuildRedisFromEnv (D4 fan-out): ONE Redis connection, built once, feeds BOTH
# the cache "redis" layer and the logger "redis" handler. There is no
# per-consumer Redis config — set it once, here. The `redis` messaging
# transport reads the same keys but opens its OWN connection (a blocking
# consume() would starve cache and logger otherwise).
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
#REDIS_PASSWORD=
#REDIS_DATABASE=0


# === cache ===
# -----------------------------------------------------------------------------
# BuildCacheFromEnv (requires jardisadapter/cache). Comma-separated layer
# list, tried in this order (write-through, first hit wins):
#   memory | apcu | redis | db
# `redis` needs the redis block; `db` needs an active database connection.
# -----------------------------------------------------------------------------
CACHE_LAYERS=memory
CACHE_NAMESPACE=app

# db layer table name (defaults to "cache" if unset)
#CACHE_DB_TABLE=cache

# Example: multi-layer with Redis + database fallback
#CACHE_LAYERS=memory,redis,db


# === logger ===
# -----------------------------------------------------------------------------
# BuildLoggerFromEnv (requires jardisadapter/logger). Comma-separated
# handler[:LEVEL] list; LEVEL defaults to LOG_LEVEL when omitted.
# Handler types: file | console | errorlog | syslog | browserconsole | redis
#                slack | teams | loki | webhook | null
# `redis` needs the redis block (shared fan-out, D4).
# -----------------------------------------------------------------------------
LOG_HANDLERS=console:DEBUG
LOG_CONTEXT=app
LOG_LEVEL=INFO

# --- file handler -------------------------------------------------------------
#LOG_HANDLERS=file:ERROR
#LOG_FILE_PATH=/var/log/app.log

# --- network handlers (URL unset -> handler skipped, no error) ---------------
#LOG_HANDLERS=slack:ERROR
#LOG_SLACK_URL=https://hooks.slack.com/services/...
#LOG_HANDLERS=teams:ERROR
#LOG_TEAMS_URL=https://outlook.office.com/webhook/...
#LOG_HANDLERS=loki:INFO
#LOG_LOKI_URL=http://loki:3100
#LOG_HANDLERS=webhook:ERROR
#LOG_WEBHOOK_URL=https://api.example.com/logs

# --- multiple handlers combined ----------------------------------------------
#LOG_HANDLERS=console:DEBUG,file:ERROR,slack:ERROR


# === http ===
# -----------------------------------------------------------------------------
# BuildHttpClientFromEnv (requires jardisadapter/http). Every value is
# optional — the client works with zero config once the adapter is installed.
# -----------------------------------------------------------------------------
#HTTP_BASE_URL=https://api.example.com
#HTTP_TIMEOUT=30
#HTTP_CONNECT_TIMEOUT=10
#HTTP_VERIFY_SSL=true
#HTTP_BEARER_TOKEN=
#HTTP_BASIC_USER=
#HTTP_BASIC_PASSWORD=
#HTTP_MAX_RETRIES=0
#HTTP_RETRY_DELAY_MS=100


# === mail ===
# -----------------------------------------------------------------------------
# BuildMailerFromEnv (requires jardisadapter/mailer).
# MAIL_HOST unset -> mailer stays null, no error.
# -----------------------------------------------------------------------------
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_TIMEOUT=30
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME=App


# === messaging ===
# -----------------------------------------------------------------------------
# BuildMessagingFromEnv (requires jardisadapter/messaging).
# MESSAGING_TRANSPORT selects exactly one of kafka | rabbitmq | redis |
# database. Unset or empty => no messaging service at all
# (DomainKernel::messaging() = null). An unrecognized value throws
# InvalidEnvConfigurationException — pick one of the four, don't guess a fifth.
# -----------------------------------------------------------------------------
MESSAGING_TRANSPORT=redis

# --- kafka --------------------------------------------------------------------
# KAFKA_BROKERS is the FULL broker list, comma-separated "host:port" pairs; it
# goes into ConnectionFactory::kafka()'s host field unchanged. There is no
# separate KAFKA_PORT key — a port alone is meaningless once a multi-broker
# list is in play (the "Kafka-Falle" this Handler avoids by design).
#KAFKA_BROKERS=kafka1:9092,kafka2:9092
#KAFKA_USER=
#KAFKA_PASSWORD=
#
# Kafka CONSUMING is not available through DomainKernel::messaging() — every
# consumer needs a consumer group ID and there is no MESSAGING_* key for one
# (a deliberate scope boundary). publish() still works; messaging()->consume()
# throws a RuntimeException explaining this. Build a
# ConnectionFactory::kafkaConsumer($brokers, $groupId) directly instead.

# --- rabbitmq -----------------------------------------------------------------
# RABBITMQ_HOST is required once MESSAGING_TRANSPORT=rabbitmq is chosen — no
# implicit "localhost" default, so a missing value is loud
# (InvalidEnvConfigurationException) at boot instead of silently connecting to
# the wrong host. PORT/USER/PASSWORD keep the adapter's own defaults.
RABBITMQ_HOST=rabbitmq
#RABBITMQ_PORT=5672
#RABBITMQ_USER=guest
#RABBITMQ_PASSWORD=guest
#
# There is no canonical queue-name key: messaging()->consume($topic, ...) uses
# $topic itself as the RabbitMQ queue name (bound to the default topic
# exchange under that same name as the routing key) — the same "topic names
# the destination" contract Kafka and Redis give the caller.

# --- redis --------------------------------------------------------------------
# Transport `redis` reads the keys of the `redis` block above — no second set
# here. It uses Redis Streams, not Pub/Sub, so a message is persisted whether
# or not a consumer happens to be listening yet.
#
# The host is required once MESSAGING_TRANSPORT=redis is chosen — unlike the
# cache/logger, where a missing host just means "no Redis at all", the
# transport was chosen explicitly, so a missing host is a config error.

# --- database -----------------------------------------------------------------
# The broker-less transport (Transactional Outbox): no container, no second
# DSN, no MESSAGING_DB_DSN key. It reuses the writer PDO the packer already
# built from the database block — the same handle dbConnection() returns —
# wrapped with manageLifecycle: false, so messaging never closes a connection
# the domain code still holds.
#
# Choosing it without a usable database connection throws
# InvalidEnvConfigurationException at boot — same rule as RABBITMQ_HOST above.
#
# BEFORE the first publish(): create the event tables as part of your normal
# migrations. jardisadapter/messaging ships the MySQL reference schema at
# src/Schema/domain_events.sql (domain_events + domain_event_subscriptions);
# MySQL, PostgreSQL and SQLite are all supported, but nothing is created on
# the fly — the kernel wires services, it does not own your schema.
#MESSAGING_TRANSPORT=database
#
# All six keys are optional; each missing one keeps the adapter's own default.
#MESSAGING_DB_TABLE=domain_events
#MESSAGING_DB_SUBSCRIPTION_TABLE=domain_event_subscriptions
# true = hard delete after processing, false = soft delete via processed_at
#MESSAGING_DB_DELETE_AFTER_PROCESSING=false
#MESSAGING_DB_POLLING_INTERVAL_MS=1000
#MESSAGING_DB_BATCH_SIZE=10
#MESSAGING_DB_MAX_ATTEMPTS=3
#
# consume() works here (unlike kafka): it polls the event table.
# Point-to-Point is the default — fan-out is a per-call option
# (messaging()->consume($topic, $handler, ['group' => 'email-service'])),
# not an ENV key; only then is the subscription table needed.
