# =============================================================================
# MESSAGING — BuildMessagingFromEnv (requires jardisadapter/messaging)
# =============================================================================
# MESSAGING_TRANSPORT selects exactly one of kafka | rabbitmq | redis |
# database. Unset or empty ⇒ no messaging service at all
# (DomainKernel::messaging() = null). An unrecognized value throws
# InvalidEnvConfigurationException — pick one of the four below, don't guess
# a fifth.
# =============================================================================

MESSAGING_TRANSPORT=redis

# --- kafka --------------------------------------------------------------
# KAFKA_BROKERS is the FULL broker list, comma-separated "host:port" pairs —
# it goes into ConnectionFactory::kafka()'s host field unchanged. There is no
# separate KAFKA_PORT key: a port on its own is meaningless once a
# multi-broker list is in play, and ConnectionFactory::kafka() ignores one
# anyway (the "Kafka-Falle" this Handler avoids by design).
#KAFKA_BROKERS=kafka1:9092,kafka2:9092
#KAFKA_USER=
#KAFKA_PASSWORD=
#
# Kafka CONSUMING is not available through DomainKernel::messaging() — every
# consumer needs a consumer group ID, and there is no MESSAGING_* key for one
# (a deliberate scope boundary, not an oversight). publish() still works;
# messaging()->consume() throws a RuntimeException explaining this. Build a
# ConnectionFactory::kafkaConsumer($brokers, $groupId) directly instead.

# --- rabbitmq -------------------------------------------------------------
# RABBITMQ_HOST is required once MESSAGING_TRANSPORT=rabbitmq is chosen — no
# implicit "localhost" default, so a missing value is loud
# (InvalidEnvConfigurationException) at boot instead of silently connecting
# to the wrong host. PORT/USER/PASSWORD keep the adapter's own defaults.
RABBITMQ_HOST=rabbitmq
#RABBITMQ_PORT=5672
#RABBITMQ_USER=guest
#RABBITMQ_PASSWORD=guest
#
# There is no canonical queue-name key: messaging()->consume($topic, ...)
# uses $topic itself as the RabbitMQ queue name (bound to the default topic
# exchange under that same name as the routing key) — the same "topic names
# the destination" contract Kafka and Redis already give the caller.

# --- redis ------------------------------------------------------------
# Same REDIS_HOST/REDIS_PORT/REDIS_PASSWORD keys as .env.redis.example (one
# stack, one Redis) — but messaging() opens its OWN connection, never the
# cache/logger's shared one: a blocking consume() call would starve the
# cache and logger if they shared it.
#
# Uses Redis Streams, not Pub/Sub — a message is persisted regardless of
# whether a consumer happens to be listening yet, matching the durability
# Kafka/RabbitMQ already provide as queued transports.
#
# REDIS_HOST is required once MESSAGING_TRANSPORT=redis is chosen — no
# implicit "localhost" default (unlike the cache/logger's own REDIS_HOST,
# whose absence just means "no Redis at all"; here the transport was already
# chosen explicitly, so a missing host is a config error, not "unconfigured").
REDIS_HOST=localhost
#REDIS_PORT=6379
#REDIS_PASSWORD=

# --- database ----------------------------------------------------------
# The broker-less transport (Transactional Outbox): no container, no second
# DSN, no MESSAGING_DB_DSN key. It reuses the writer PDO the Bootstrap-Packer
# already built from DB_* (.env.database.example) — the same handle
# dbConnection() returns — wrapped with manageLifecycle: false, so messaging
# never closes a connection the domain code still holds.
#
# Choosing it without a usable DB_* connection throws
# InvalidEnvConfigurationException at boot ("MESSAGING_TRANSPORT=database
# requires a configured database (DB_*).") — same rule as RABBITMQ_HOST above:
# an explicitly chosen transport with missing mandatory config is an error,
# not a silent degrade-to-null.
#
# BEFORE the first publish(): create the event tables as part of your normal
# migrations. jardisadapter/messaging ships the MySQL reference schema at
# src/Schema/domain_events.sql (domain_events + domain_event_subscriptions);
# MySQL, PostgreSQL and SQLite are all supported by the transport, but nothing
# is created on the fly — the kernel wires services, it does not own your
# schema.
#MESSAGING_TRANSPORT=database
#
# All six keys are optional; each missing one keeps the adapter's own default.
#MESSAGING_DB_TABLE=domain_events
#MESSAGING_DB_SUBSCRIPTION_TABLE=domain_event_subscriptions
# true = hard delete after processing, false = soft delete via processed_at
#MESSAGING_DB_DELETE_AFTER_PROCESSING=false
#MESSAGING_DB_POLLING_INTERVAL_MS=1000
#MESSAGING_DB_BATCH_SIZE=10
#MESSAGING_DB_MAX_ATTEMPTS=3
#
# consume() works here (unlike kafka): it polls the event table.
# Point-to-Point is the default — fan-out is a per-call option
# (messaging()->consume($topic, $handler, ['group' => 'email-service'])),
# not an ENV key; only then is the subscription table needed.
