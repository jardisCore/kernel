# =============================================================================
# App Config Root — Bootstrap-Packer cascade
# =============================================================================
# Copy this tree next to your App bootstrap and strip the ".example" suffix
# from every file (including this one -> .env). Loaded by
# BuildDomainKernelFromEnv via DotEnv::loadPrivate() (load()/load?() cascade).
# =============================================================================

# In the Jardis App Template convention, `config/env/.env` starts with
# `load(../../.env)` as its first line (not shown active here — these
# example files don't live at a project's config/env root): the project
# root `.env` is the stack truth (Docker Compose values + shared
# credentials), and the app reads it via that include.

load(.env.database)
load?(.env.redis)
load?(.env.cache)
load?(.env.logger)
load?(.env.http)
load?(.env.mail)
load?(.env.messaging)
